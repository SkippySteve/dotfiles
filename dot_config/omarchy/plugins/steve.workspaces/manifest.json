{
  "schemaVersion": 1,
  "id": "steve.workspaces",
  "name": "My Workspaces",
  "version": "1.0.0",
  "author": "Omarchy",
  "description": "Workspace number indicators",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Workspaces.qml"
  },
  "barWidget": {
    "displayName": "My Workspaces",
    "description": "Workspace number indicators",
    "category": "Compositor",
    "allowMultiple": false,
    "defaults": {
      "count": 10
    },
    "schema": [
      {
        "key": "count",
        "type": "number",
        "label": "Workspaces per monitor",
        "description": "How many of this screen's ten slots the bar shows.",
        "defaultValue": 10
      }
    ]
  },
  "omarchy": {
    "clonedFrom": "omarchy.workspaces"
  }
}
